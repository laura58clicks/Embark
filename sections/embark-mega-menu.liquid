  "settings": [
    { "type": "paragraph", "content": "Opciones equivalentes al Header del theme: colores, layout, sticky, paddings, logo y overlay." },
    { "type": "header", "content": "Colores" },
    { "type": "checkbox", "id": "use_custom_colors", "label": "Usar colores personalizados", "info": "Desactivalo para usar un esquema de color del theme.", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color del header", "default": "default", "visible_if": "{{ section.settings.use_custom_colors == false }}" },
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#FFFFFF", "visible_if": "{{ section.settings.use_custom_colors }}" },
    { "type": "color", "id": "ink", "label": "Texto", "default": "#1C2230", "visible_if": "{{ section.settings.use_custom_colors }}" },
    { "type": "color", "id": "muted", "label": "Texto secundario", "default": "#5D6575", "visible_if": "{{ section.settings.use_custom_colors }}" },
    { "type": "color", "id": "line", "label": "Líneas", "default": "#DCDEE3", "visible_if": "{{ section.settings.use_custom_colors }}" },
    { "type": "color", "id": "accent", "label": "Acento (subrayado / hover)", "default": "#94712F", "visible_if": "{{ section.settings.use_custom_colors }}" },
    { "type": "color", "id": "accent_soft", "label": "Acento suave (buscador / tile)", "default": "#F2EADB", "visible_if": "{{ section.settings.use_custom_colors }}" },
    { "type": "color", "id": "tile_soft", "label": "Tile degradé (2º color)", "default": "#E4E8F0", "visible_if": "{{ section.settings.use_custom_colors }}" },

    { "type": "header", "content": "Navegación" },
    { "type": "link_list", "id": "row1_menu", "label": "Row 1 · Brand + services" },
    { "type": "link_list", "id": "shopby_menu", "label": "Level 1 · SHOP BY + categorías", "info": "Nivel 2 = columnas, nivel 3 = links. Ítems sin hijos = link directo." },
    { "type": "checkbox", "id": "show_drop_heading", "label": "Mostrar título en los dropdowns de Row 1", "info": "Ej.: ABOUT, STORES & EXPERIENCES, BOOK AN APPOINTMENT.", "default": true },
    { "type": "text", "id": "bold_titles", "label": "Links en negrita", "info": "Títulos separados por coma. 'Shop All…' ya va en negrita.", "default": "Bridal Appointment" },

    { "type": "header", "content": "Header" },
    { "type": "checkbox", "id": "enable_full_width", "label": "Ancho completo", "default": true },
    { "type": "select", "id": "logo_position", "label": "Posición del logo (desktop)", "default": "left", "options": [
