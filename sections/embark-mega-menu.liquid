    { "type": "textarea", "id": "overlay_handles", "label": "Activar en estos handles", "info": "Un handle por línea (páginas, productos, etc.)." },
    { "type": "color", "id": "overlay_text_color", "label": "Color del texto en overlay", "default": "#FFFFFF" },
    { "type": "image_picker", "id": "logo_with_background_color", "label": "Logo para overlay", "info": "Versión clara del logo para usar sobre imágenes." },

    { "type": "header", "content": "Logo del drawer (mobile)" },
    { "type": "select", "id": "drawer_logo", "label": "Logo en el drawer", "default": "none", "options": [
      { "value": "none", "label": "Texto" },
      { "value": "header", "label": "Logo del header" },
