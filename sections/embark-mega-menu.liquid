      { "value": "center", "label": "Centro" },
      { "value": "right", "label": "Derecha" }
    ] },
    { "type": "select", "id": "logo_position_mobile", "label": "Posición del logo (mobile)", "default": "center", "options": [
      { "value": "left", "label": "Izquierda" },
      { "value": "center", "label": "Centro" }
    ] },
