    { "type": "range", "id": "drawer_logo_max_width", "label": "Ancho del logo del drawer", "min": 30, "max": 200, "step": 10, "unit": "px", "default": 100, "visible_if": "{{ section.settings.drawer_logo != 'none' }}" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Featured tile",
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Categoría (título exacto del ítem de menú)", "default": "Earrings" },
