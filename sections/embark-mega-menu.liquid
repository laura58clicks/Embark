      { "value": "fixed", "label": "Siempre visible" },
      { "value": "scroll", "label": "Visible al scrollear hacia arriba" }
    ] },
    { "type": "checkbox", "id": "header_uses_icons", "label": "Usar íconos", "info": "Si se desactiva, muestra texto (Account, Cart).", "default": true },
    { "type": "checkbox", "id": "show_search", "label": "Mostrar buscador", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Placeholder del buscador", "default": "Search…", "visible_if": "{{ section.settings.show_search }}" },
    { "type": "checkbox", "id": "show_wishlist", "label": "Mostrar Wishlist", "default": true },
